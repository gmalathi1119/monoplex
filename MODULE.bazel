"""
Polyglot monorepo — root module.

Design decision: bzlmod (MODULE.bazel) over legacy WORKSPACE.
See docs/adr/0001-monorepo-and-build-system.md and
docs/adr/0002-bzlmod-over-workspace.md for rationale.
"""

module(
    name = "monorepo",
    version = "0.1.0",
)

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_go", version = "0.50.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.39.1")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.2")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//go:go.mod")
use_repo(go_deps, "com_github_stretchr_testify")

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_python", version = "0.40.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_deps",
    python_version = "3.12",
    requirements_lock = "//python:requirements_lock.txt",
)
use_repo(pip, "pip_deps")

# ---------------------------------------------------------------------------
# C++ — uses Bazel's built-in cc toolchain; googletest for testing.
# ---------------------------------------------------------------------------
bazel_dep(name = "googletest", version = "1.15.2")

# ---------------------------------------------------------------------------
# Java
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_java", version = "8.5.1")
bazel_dep(name = "rules_jvm_external", version = "6.3")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "com.google.guava:guava:33.3.1-jre",
        "junit:junit:4.13.2",
    ],
    repositories = ["https://repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
